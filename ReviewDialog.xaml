<Window x:Class="RecompVault.ReviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Revisar detección" Width="1280" Height="760" MinWidth="900" MinHeight="480"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
    <Window.Resources>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#141922"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="{StaticResource EdgeBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#3A2A30"/>
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFuzzyLink}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource WarnBrush}"/>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#20FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock DockPanel.Dock="Left" Text="Revisar detección" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/>
            <ComboBox x:Name="FilterBox" DockPanel.Dock="Left" Width="260" SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="Todos" Tag="all"/>
                <ComboBoxItem Content="≈ Vínculo aproximado" Tag="fuzzy"/>
                <ComboBoxItem Content="Sin vincular" Tag="unlinked"/>
                <ComboBoxItem Content="Versión instalada desconocida" Tag="unknown"/>
                <ComboBoxItem Content="Con actualización" Tag="update"/>
                <ComboBoxItem Content="Actualizados por RecompVault antiguo" Tag="oldrv"/>
                <ComboBoxItem Content="Sin ejecutable" Tag="noexe"/>
                <ComboBoxItem Content="Versión fijada" Tag="pinned"/>
                <ComboBoxItem Content="Vinculados por Gaming Emporium" Tag="emporium"/>
                <ComboBoxItem Content="Sin verificar por huella (vinculados)" Tag="unverified"/>
                <ComboBoxItem Content="✖ Huella no coincide" Tag="fpbad"/>
            </ComboBox>
            <TextBox x:Name="SearchBox" Margin="10,0,0,0" Padding="8,5" TextChanged="Filter_Changed" ToolTip="Buscar por nombre, carpeta o repositorio"/>
        </DockPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="False">
            <TextBlock x:Name="CountText" DockPanel.Dock="Left" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" Content="Cerrar" Style="{StaticResource GhostButton}" MinWidth="90" IsCancel="True" Click="Close_Click"/>
            <Button DockPanel.Dock="Right" Content="⇩ Exportar CSV" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="Export_Click"/>
            <Button DockPanel.Dock="Right" Content="⊘ Desvincular seleccionados" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="Unlink_Click"
                    ToolTip="No buscar actualizaciones de los juegos seleccionados"/>
            <Button DockPanel.Dock="Right" Content="✔ Confirmar vínculo de seleccionados" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="Confirm_Click"
                    ToolTip="El vínculo actual pasa a ser manual (seguro): ya podrá auto-actualizarse"/>
            <Button DockPanel.Dock="Right" Content="ℹ Detección..." Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="Detail_Click"/>
            <Button DockPanel.Dock="Right" Content="🔬 Verificar seleccionados" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="Verify_Click"
                    ToolTip="Confirma vínculo y versión comparando con los releases de GitHub (SHA-256 del paquete o CRC32 del ejecutable)"/>
        </DockPanel>

        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource EdgeBrush}" BorderThickness="1" CornerRadius="10" Padding="2">
            <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow"
                      HeadersVisibility="Column" GridLinesVisibility="None" Background="Transparent" BorderThickness="0"
                      RowBackground="Transparent" AlternatingRowBackground="#0CFFFFFF" Foreground="{StaticResource TextBrush}"
                      CanUserReorderColumns="True" CanUserSortColumns="True" EnableRowVirtualization="True"
                      MouseDoubleClick="Grid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="2*"/>
                    <DataGridTextColumn Header="Sistema" Binding="{Binding System}" Width="80"/>
                    <DataGridTextColumn Header="Avisos" Binding="{Binding ReviewFlags}" Width="1.4*"/>
                    <DataGridTextColumn Header="Huella" Binding="{Binding Fingerprint}" Width="100"/>
                    <DataGridTextColumn Header="Vínculo" Binding="{Binding LinkSource}" Width="2*"/>
                    <DataGridTextColumn Header="Repositorio" Binding="{Binding Repository}" Width="1.6*"/>
                    <DataGridTextColumn Header="Instalada" Binding="{Binding InstalledVersion}" Width="90"/>
                    <DataGridTextColumn Header="Última" Binding="{Binding LatestVersion}" Width="90"/>
                    <DataGridTextColumn Header="Carpeta" Binding="{Binding RecompName}" Width="1.6*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</Window>

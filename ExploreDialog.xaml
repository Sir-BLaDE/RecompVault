<Window x:Class="RecompVault.ExploreDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:RecompVault.Converters"
        Title="Explorar el catálogo de Quiver" Width="1380" Height="860" MinWidth="1000" MinHeight="560"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
    <Window.Resources>
        <c:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="Tile" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="B" Width="168" CornerRadius="12" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource EdgeBrush}" BorderThickness="2">
                            <StackPanel>
                                <Border Height="232" CornerRadius="10,10,0,0" ClipToBounds="True" Background="#141922">
                                    <Grid>
                                        <TextBlock Text="{Binding App.Name}" Foreground="#55FFFFFF" FontSize="15" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center"
                                                   VerticalAlignment="Center" Margin="12"/>
                                        <Image Source="{Binding Image}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" CornerRadius="7" Padding="7,2" Background="{Binding BadgeColor}"
                                                Visibility="{Binding HasBadge, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding Badge}" Foreground="White" FontSize="9.5" FontWeight="Black"/>
                                        </Border>
                                        <Border HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Background="#D9101318" Padding="8,4"
                                                Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding InstalledText}" Foreground="{StaticResource Accent2Brush}" FontSize="10" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                    </Grid>
                                </Border>
                                <StackPanel Margin="10,8,10,10">
                                    <TextBlock Text="{Binding App.Name}" FontWeight="Bold" FontSize="12.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding App.Name}"/>
                                    <TextBlock Text="{Binding Consoles}" Foreground="{StaticResource MutedBrush}" FontSize="10.5" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding DateText}" Foreground="#8FA0B8" FontSize="10" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="#56607A"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Margin="18">
        <!-- cabecera y filtros -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,24,0">
                <TextBlock Text="✦ Explorar Quiver" FontSize="22" FontWeight="Black"/>
                <TextBlock Text="Novedades del catálogo de quiverlauncher.com" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
            </StackPanel>
            <ComboBox x:Name="SortBox" DockPanel.Dock="Left" Width="200" VerticalAlignment="Center" SelectionChanged="Sort_Changed">
                <ComboBoxItem Content="Actualizados recientemente" Tag="updated"/>
                <ComboBoxItem Content="Añadidos recientemente" Tag="added"/>
                <ComboBoxItem Content="Mejor valorados" Tag="rating"/>
                <ComboBoxItem Content="Nombre (A-Z)" Tag="name"/>
            </ComboBox>
            <ComboBox x:Name="ConsoleBox" DockPanel.Dock="Left" Width="190" Margin="10,0,0,0" VerticalAlignment="Center" SelectionChanged="Filter_Changed"/>
            <CheckBox x:Name="HideOwnedBox" DockPanel.Dock="Left" Content="Ocultar los que ya tengo" Margin="14,0,0,0" VerticalAlignment="Center"
                      Foreground="{StaticResource TextBrush}" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
            <CheckBox x:Name="WindowsBox" DockPanel.Dock="Left" Content="Solo Windows" Margin="14,0,0,0" VerticalAlignment="Center" IsChecked="True"
                      Foreground="{StaticResource TextBrush}" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
            <TextBox x:Name="SearchBox" Margin="16,0,0,0" Padding="8,6" VerticalAlignment="Center" KeyDown="Search_KeyDown"
                     ToolTip="Buscar en el catálogo (Intro)"/>
        </DockPanel>

        <!-- pie -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="False">
            <TextBlock x:Name="StatusText" DockPanel.Dock="Left" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" Content="Cerrar" Style="{StaticResource GhostButton}" MinWidth="90" IsCancel="True" Click="Close_Click"/>
            <Button x:Name="MoreBtn" DockPanel.Dock="Right" Content="Cargar más" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="More_Click" IsEnabled="False"/>
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <ListBox x:Name="List" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource Tile}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="List_SelectionChanged">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>

            <!-- detalle -->
            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource EdgeBrush}" BorderThickness="1" CornerRadius="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="DetailPanel" Visibility="Collapsed">
                        <Border Height="186" CornerRadius="13,13,0,0" ClipToBounds="True" Background="#141922">
                            <Image x:Name="HeroImage" Stretch="UniformToFill"/>
                        </Border>
                        <StackPanel Margin="18,14,18,18">
                            <TextBlock x:Name="DName" FontSize="20" FontWeight="Black" TextWrapping="Wrap"/>
                            <TextBlock x:Name="DSub" Foreground="{StaticResource MutedBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <TextBlock x:Name="DVersions" FontSize="11.5" TextWrapping="Wrap" Margin="0,10,0,0" FontFamily="Consolas, Segoe UI"/>
                            <TextBlock x:Name="DInstalled" Foreground="{StaticResource Accent2Brush}" FontWeight="Bold" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            <TextBlock x:Name="DDesc" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="#D0D6E2"/>

                            <WrapPanel Margin="0,14,0,0">
                                <Button Content="Ver en quiverlauncher.com" Style="{StaticResource GhostButton}" Margin="0,0,8,8" Click="OpenSite_Click"/>
                                <Button Content="Releases" Style="{StaticResource GhostButton}" Margin="0,0,8,8" Click="OpenReleases_Click"/>
                            </WrapPanel>

                            <Border Background="#141922" CornerRadius="10" Padding="12" Margin="0,8,0,0" BorderBrush="{StaticResource EdgeBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="INSTALAR EN TU BIBLIOTECA" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="Sistema" Width="70" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="SystemBox" IsEditable="True" Padding="8,4,24,4" ToolTip="Carpeta de sistema dentro de la raíz (puedes escribir una nueva)"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="Carpeta" Width="70" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                        <TextBox x:Name="FolderBox" Padding="8,4"/>
                                    </DockPanel>
                                    <TextBlock x:Name="TargetText" Foreground="{StaticResource MutedBrush}" FontSize="10.5" TextWrapping="Wrap" Margin="0,2,0,10"/>
                                    <Button x:Name="InstallBtn" Content="⇩ Elegir versión e instalar" Style="{StaticResource PrimaryButton}" Click="Install_Click"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <TextBlock x:Name="EmptyDetail" Grid.Column="2" Text="Elige una app para ver los detalles" Foreground="{StaticResource MutedBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </DockPanel>
</Window>

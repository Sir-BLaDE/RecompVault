<Window x:Class="RecompVault.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ajustes" Width="820" Height="760" MinWidth="680" MinHeight="500"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
    <Window.Resources>
        <Style x:Key="Sec" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,14,0,8"/>
        </Style>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="190"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="190,2,0,8"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="18">
        <TextBlock DockPanel.Dock="Top" Text="Ajustes" FontSize="22" FontWeight="Bold" Margin="0,0,0,6"/>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="📁 Carpeta de datos" Style="{StaticResource GhostButton}" Click="OpenData_Click" ToolTip="%APPDATA%\RecompVault"/>
            <Button DockPanel.Dock="Right" Content="Guardar" Style="{StaticResource PrimaryButton}" MinWidth="110" IsDefault="True" Click="Save_Click"/>
            <Button DockPanel.Dock="Right" Content="Cancelar" Style="{StaticResource GhostButton}" MinWidth="100" Margin="0,0,8,0" IsCancel="True"/>
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="BIBLIOTECA" Style="{StaticResource Sec}"/>
                <DockPanel Margin="0,2">
                    <TextBlock Text="Carpeta raíz" Style="{StaticResource Lbl}"/>
                    <Button DockPanel.Dock="Right" Content="..." Style="{StaticResource GhostButton}" Padding="10,4" Margin="6,0,0,0" Click="BrowseRoot_Click"/>
                    <TextBox x:Name="RootBox" Padding="8,5"/>
                </DockPanel>
                <TextBlock Text="La que contiene las carpetas por sistema (N64, PSX, X360...)." Style="{StaticResource Hint}"/>

                <TextBlock Text="QUIVER LAUNCHER" Style="{StaticResource Sec}"/>
                <CheckBox x:Name="QuiverEnabledBox" Content="Usar los datos de Quiver (nombres, iconos, repositorios, versiones)"/>
                <DockPanel Margin="0,4">
                    <TextBlock Text="Carpeta de Quiver" Style="{StaticResource Lbl}"/>
                    <Button DockPanel.Dock="Right" Content="Detectar" Style="{StaticResource GhostButton}" Padding="10,4" Margin="6,0,0,0" Click="DetectQuiver_Click"/>
                    <Button DockPanel.Dock="Right" Content="..." Style="{StaticResource GhostButton}" Padding="10,4" Margin="6,0,0,0" Click="BrowseQuiver_Click"/>
                    <TextBox x:Name="QuiverBox" Padding="8,5"/>
                </DockPanel>
                <TextBlock x:Name="QuiverHint" Text="Vacío = detectar automáticamente." Style="{StaticResource Hint}"/>
                <CheckBox x:Name="ExternalBox" Content="Mostrar también las apps de Quiver instaladas fuera de la carpeta raíz"/>
                <CheckBox x:Name="FuzzyBox" Content="Vincular también por coincidencia aproximada (puede equivocarse; si no, aparecen como sugerencia en ℹ)"/>

                <TextBlock Text="ACTUALIZACIONES" Style="{StaticResource Sec}"/>
                <CheckBox x:Name="AutoCheckBox" Content="Comprobar actualizaciones al arrancar"/>
                <CheckBox x:Name="AutoUpdateBox" Content="Instalar actualizaciones automáticamente (solo vínculos seguros, nunca aproximados)"/>
                <CheckBox x:Name="PreBox" Content="Incluir prereleases"/>
                <CheckBox x:Name="ChangelogBox" Content="Al actualizar a mano, mostrar antes las notas del release y el paquete"/>
                <DockPanel Margin="0,6,0,2">
                    <TextBlock Text="Intervalo de comprobación (h)" Style="{StaticResource Lbl}"/>
                    <TextBox x:Name="IntervalBox" Width="80" Padding="8,5" HorizontalAlignment="Left"/>
                </DockPanel>
                <TextBlock Text="Horas mínimas entre consultas automáticas del mismo repositorio (la comprobación manual siempre consulta)." Style="{StaticResource Hint}"/>
                <DockPanel Margin="0,2">
                    <TextBlock Text="Copias de deshacer por juego" Style="{StaticResource Lbl}"/>
                    <TextBox x:Name="UndoKeepBox" Width="80" Padding="8,5" HorizontalAlignment="Left"/>
                </DockPanel>
                <TextBlock Text="Solo se guardan los ficheros que reemplaza cada actualización." Style="{StaticResource Hint}"/>
                <DockPanel Margin="0,2">
                    <TextBlock Text="Ficheros protegidos" Style="{StaticResource Lbl}" VerticalAlignment="Top" Margin="0,6,0,0"/>
                    <TextBox x:Name="ProtectedBox" Padding="8,5" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56"/>
                </DockPanel>
                <TextBlock Text="Patrones separados por ';' que nunca se sobrescriben si ya existen (partidas, ajustes). Ej.: saves/**; *.sav; config/user.json" Style="{StaticResource Hint}"/>

                <TextBlock Text="CLAVES Y TOKENS" Style="{StaticResource Sec}"/>
                <DockPanel Margin="0,2">
                    <TextBlock Text="Token de GitHub" Style="{StaticResource Lbl}"/>
                    <TextBox x:Name="GitHubBox" Padding="8,5"/>
                </DockPanel>
                <TextBlock Text="Opcional: sube el límite de la API de 60 a 5000 consultas/hora. Un token fine-grained sin permisos basta (github.com/settings/tokens)." Style="{StaticResource Hint}"/>
                <DockPanel Margin="0,2">
                    <TextBlock Text="SteamGridDB API key" Style="{StaticResource Lbl}"/>
                    <TextBox x:Name="SgdbBox" Padding="8,5"/>
                </DockPanel>
                <TextBlock Text="Para portadas (steamgriddb.com/profile/preferences/api)." Style="{StaticResource Hint}"/>
                <DockPanel Margin="0,2">
                    <TextBlock Text="RAWG API key" Style="{StaticResource Lbl}"/>
                    <TextBox x:Name="RawgBox" Padding="8,5"/>
                </DockPanel>
                <DockPanel Margin="0,8,0,2">
                    <TextBlock Text="IGDB Client ID" Style="{StaticResource Lbl}"/>
                    <TextBox x:Name="IgdbIdBox" Padding="8,5"/>
                </DockPanel>
                <DockPanel Margin="0,2">
                    <TextBlock Text="IGDB Client Secret" Style="{StaticResource Lbl}"/>
                    <TextBox x:Name="IgdbSecretBox" Padding="8,5"/>
                </DockPanel>
                <TextBlock Text="Credenciales de una aplicación de dev.twitch.tv/console/apps." Style="{StaticResource Hint}"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
